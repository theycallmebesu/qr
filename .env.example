# MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster0.mongodb.net/hardwareshop_db?retryWrites=true&w=majority)
MONGODB_URI=

# Secret key used to sign JWT admin session tokens (min 32 random characters)
JWT_SECRET=

# Bcrypt hash of your admin password (generate with: npm run hash-password <your_password>)
ADMIN_PASSWORD_HASH=

# Cloudinary credentials for product image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
